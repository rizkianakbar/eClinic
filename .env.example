# Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Not app variables: GitHub repository secrets for the nightly backup -----
# Set these in GitHub → Settings → Secrets and variables → Actions, NOT in .env.local.
# Used only by .github/workflows/backup.yml (see README → "Backup dan restore").
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# BACKUP_PASSPHRASE=<long random passphrase; keep a copy outside GitHub, needed to restore>

# Demo deployment only: show one-click test-account logins on the login page in a production build.
# Leave unset for a real clinic.
# DEMO_LOGIN=true
