# Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# The marketing site's domain; each clinic is served at <slug>.<this>. Defaults to localhost:3000 in development
# (open http://localhost:3000 for the site, http://demo.localhost:3000 for the demo clinic).
# NEXT_PUBLIC_ROOT_DOMAIN=clinic.rzknkbr.xyz

# --- Not app variables: GitHub repository secrets for the nightly backup -----
# Set these in GitHub → Settings → Secrets and variables → Actions, NOT in .env.local.
# Used only by .github/workflows/backup.yml (see README → "Backup dan restore").
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# BACKUP_PASSPHRASE=<long random passphrase; keep a copy outside GitHub, needed to restore>

# One-click test-account logins on the demo clinic's login page (demo.<root domain>) in a production build.
# Never shown on any other clinic's address.
# DEMO_LOGIN=true
